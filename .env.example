# Copy to .env for local use. In GitHub Codespaces, prefer Codespaces secrets
# (Settings > Codespaces > Secrets) so credentials never touch the repo.
# .env is git-ignored. Never commit real credentials.

PORT=3000

# Public URL PayPal and the payer's browser can reach. In Codespaces:
#   1. Ports tab > port 3000 > Port Visibility > Public
#   2. Use the forwarded address, e.g. https://<codespace-name>-3000.app.github.dev
PUBLIC_BASE_URL=http://localhost:3000

# ── PayPal SANDBOX ──────────────────────────────────────────────────────────
# developer.paypal.com > Apps & Credentials > Sandbox > your app.
# Leave blank to run against the offline fake (nothing reaches PayPal).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Developer Dashboard > your app > Webhooks > add PUBLIC_BASE_URL/webhooks/paypal
# for CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.REFUNDED,
# then paste the Webhook ID here.
PAYPAL_WEBHOOK_ID=
# The app refuses to start against a non-sandbox URL unless ALLOW_LIVE=1.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ── AI ──────────────────────────────────────────────────────────────────────
# Use ONE of these. Paywarden picks Claude if ANTHROPIC_API_KEY is set, otherwise any
# OpenAI-compatible API if AI_API_KEY is set, otherwise a weak offline fallback (tests only).
#
# Free option: Google Gemini API free tier. Get a key at https://aistudio.google.com/apikey
# (sign in with a Google account; check that page for current terms). Free-tier prompts may be used by
# Google to improve its products, so only send demo data.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Comma-separated: tried in order, moving on when a model is busy, missing or slow.
AI_MODEL=gemini-3-flash-preview,gemini-3.1-flash-lite-preview,gemini-3.8-flash
#
# Paid option: Claude (Anthropic API, needs account credit).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Access tokens ───────────────────────────────────────────────────────────
# Two kinds of credential on purpose: an agent token can only ask to pay; an owner token can
# approve, refund, revoke and freeze. Every token must be different (the server refuses to start
# otherwise), and in production at least 24 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# If unset, insecure built-in dev tokens are used (fine locally, refused in production).
AGENT_API_TOKEN=
OWNER_API_TOKEN=
#
# Optional, recommended when more than one person approves: one token per approver. The name
# recorded in the audit log then comes from the token, not from what someone types (names
# typed with the shared OWNER_API_TOKEN are recorded as "(unverified)").
# OWNER_TOKENS=sahil=<random token>,priya=<another random token>
#
# Optional: tokens bound to one agent. A bound token can only pay, read and capture for that
# agent's permits and orders, over HTTP and MCP.
# AGENT_TOKENS=travel-shopper=<random token>

# ── Mandate signing ─────────────────────────────────────────────────────────
# Optional: a fixed Ed25519 key (PKCS8 PEM, with \n for newlines) so mandates survive restarts.
# Generate with:  node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}).toString().replace(/\n/g,'\\\\n'))"
MANDATE_SIGNING_KEY_PEM=

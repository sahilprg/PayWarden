# Copy to .env for local use. In GitHub Codespaces, prefer Codespaces secrets
# (Settings > Codespaces > Secrets) so credentials never touch the repo.
# .env is git-ignored. Never commit real credentials.

PORT=3000

# Public URL PayPal and the payer's browser can reach. In Codespaces:
#   1. Ports tab > port 3000 > Port Visibility > Public
#   2. Use the forwarded address, e.g. https://<codespace-name>-3000.app.github.dev
PUBLIC_BASE_URL=http://localhost:3000

# ── PayPal SANDBOX ──────────────────────────────────────────────────────────
# developer.paypal.com > Apps & Credentials > Sandbox > your app.
# Leave blank to run against the offline fake (nothing reaches PayPal).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Developer Dashboard > your app > Webhooks > add PUBLIC_BASE_URL/webhooks/paypal
# for CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.REFUNDED,
# then paste the Webhook ID here.
PAYPAL_WEBHOOK_ID=
# The app refuses to start against a non-sandbox URL unless ALLOW_LIVE=1.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ── AI ──────────────────────────────────────────────────────────────────────
# Leave blank to use the offline rule-based fallback (much weaker; for tests and demos).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Access tokens ───────────────────────────────────────────────────────────
# Two separate credentials on purpose: the AI agent gets AGENT_API_TOKEN and can only
# ask to pay. Only the human owner's OWNER_API_TOKEN can approve, refund or freeze.
# Generate with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# If unset, insecure built-in dev tokens are used (fine locally, refused in production).
AGENT_API_TOKEN=
OWNER_API_TOKEN=

# Optional: a fixed Ed25519 key (PKCS8 PEM, with \n for newlines) so mandates survive restarts.
# Generate with:  node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}).toString().replace(/\n/g,'\\\\n'))"
MANDATE_SIGNING_KEY_PEM=

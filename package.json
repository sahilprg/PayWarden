{
  "name": "paywarden",
  "version": "0.1.0",
  "description": "Open-source trust layer for AI agents that spend money through PayPal: signed spending mandates, deterministic policy enforcement, idempotent execution, tamper-evident audit and merchant-approved remedies.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.9 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "lab": "node --import tsx src/lab/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "node --env-file-if-exists=.env --import tsx scripts/demo.ts",
    "simulate": "node --env-file-if-exists=.env --import tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "ag-grid-community": "36.2.0",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
